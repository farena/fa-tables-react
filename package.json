{
  "name": "@farena/fa-tables-react",
  "version": "1.2.2",
  "description": "React table component with server-side pagination, configurable columns, row actions and render slots.",
  "keywords": [
    "react",
    "table",
    "datatable",
    "data-table",
    "pagination",
    "server-side",
    "filters",
    "laravel",
    "typescript"
  ],
  "author": "Federico Arena",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/farena/fa-tables-react.git"
  },
  "homepage": "https://github.com/farena/fa-tables-react#readme",
  "bugs": {
    "url": "https://github.com/farena/fa-tables-react/issues"
  },
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/fa-tables-react.cjs",
  "module": "./dist/fa-tables-react.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/fa-tables-react.js",
      "require": "./dist/fa-tables-react.cjs"
    },
    "./style.css": "./dist/style.css"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "dev": "vite",
    "build": "npm run build:lib",
    "build:lib": "vite build --config vite.lib.config.ts && tsc -p tsconfig.lib.json",
    "build:demo": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "prepare": "npm run build:lib",
    "prepublishOnly": "npm run lint"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sass": "^1.105.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.3.0"
  }
}
